# Gate for / -> /gallery and /guestbook
SITE_PASSWORD=change-me

# Separate gate for /upload
ADMIN_PASSWORD=change-me-too

# Added automatically when you connect a Vercel Blob store to the project
BLOB_READ_WRITE_TOKEN=

# Added automatically when you connect Vercel KV (Upstash Redis) to the project
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: auto-import photos dropped into a Google Drive folder.
# See README "Auto-import from Google Drive" for setup steps.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Random secret so only Vercel's own cron invocations (not randos) can
# trigger /api/drive/sync. Generate with: openssl rand -hex 32
CRON_SECRET=
